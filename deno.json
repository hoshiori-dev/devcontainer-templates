{
  "lock": true,
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      ".agents/skills/",
      ".claude/",
      "src/*/README.md",
      "build/"
    ]
  },
  "lint": {
    "include": [
      "scripts/"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "tasks": {
    "check": "just check",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env scripts/"
  }
}
