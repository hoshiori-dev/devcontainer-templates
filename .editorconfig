root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{md,mdx,markdown}]
trim_trailing_whitespace = false

[*.{patch,diff}]
trim_trailing_whitespace = false
insert_final_newline = unset

[Dockerfile*]
indent_size = 4

[Containerfile*]
indent_size = 4

[*.{Dockerfile,Containerfile}]
indent_size = 4

[*.{py,pyi,rs,java,kt,kts,cs,fs,fsx,swift,php,c,cc,cpp,cxx,h,hpp,hxx}]
indent_size = 4

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.go]
indent_style = tab
indent_size = tab
tab_width = 8

[justfile]
indent_style = space
indent_size = 4

[{Makefile,GNUmakefile,makefile,*.mk}]
indent_style = tab
indent_size = tab
tab_width = 8

[LICENSE]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset
